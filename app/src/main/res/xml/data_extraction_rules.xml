<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup=false : on n'expose AUCUNE donnée au backup cloud (privacy).
  Ce fichier est référencé pour la conformité Android 12+ mais reste vide.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
