<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration du service d'accessibilité.

  Correctif v1.3 : le service doit pouvoir VÉRIFIER que le split est réellement
  actif (et non croire le résultat de GLOBAL_ACTION_TOGGLE_SPLIT_SCREEN sur
  parole). On active donc :
    - canRetrieveWindowContent="true"
    - flagRetrieveInteractiveWindows

  Correctif v1.5 : on écoute AUSSI typeWindowsChanged. Les attentes
  (waitForSplit / waitForSplitExit) sont ainsi ÉVÉNEMENTIELLES — réveillées dès
  que les fenêtres changent — au lieu de sonder à l'aveugle : confirmation plus
  rapide et beaucoup moins d'appels système.

  Cela permet de lire la STRUCTURE des fenêtres : leur TYPE (notamment la
  présence d'un TYPE_SPLIT_SCREEN_DIVIDER) et leurs DIMENSIONS à l'écran (pour
  reconnaître deux applications occupant deux régions distinctes). Aucun
  CONTENU (texte, champs de saisie, images) n'est lu ni transmis : getRoot()
  n'est jamais appelé. Cette utilisation est clairement divulguée à
  l'utilisateur (voir la description ci-dessous).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.ninja.splitlauncher.MainActivity" />
