<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/floating_bg"
    android:padding="6dp">

    <TextView
        android:id="@+id/floatingSplit"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minWidth="64dp"
        android:gravity="center"
        android:background="@drawable/floating_btn_bg"
        android:text="@string/floating_launch"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="13sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <TextView
        android:id="@+id/floatingClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:background="@drawable/floating_btn_bg_alt"
        android:text="✕"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp" />
</LinearLayout>
